# Modified by LocalPitch, 2026
# LocalPitch assistant server (Grana). Copy .env.example to .env, then apply
# these values. Placeholders only — generate secrets with `openssl rand -hex 32`
# and never commit the filled-in file.
#
# Public host is agent.<domain>. LocalPitch the app stays at app.<domain> and
# is the only identity provider. Match OIDC_CLIENT_ID / OIDC_CLIENT_SECRET to
# LocalPitch's OIDC_RAKAZO_CLIENT_ID / OIDC_RAKAZO_CLIENT_SECRET.

NODE_ENV=production
RAKAZO_HOST=agent.example.com
BETTER_AUTH_URL=https://agent.example.com
WEB_ORIGIN=https://agent.example.com
API_URL=https://agent.example.com

# Sign-in. See docs/localpitch/DEPLOY.md for why this combination.
OIDC_ISSUER=https://app.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=LocalPitch
OIDC_SCOPES=openid email profile
AUTH_PASSWORD_ENABLED=false
SIGNUPS_ENABLED=true
SIGNUP_ALLOWLIST=
OIDC_ALLOW_SIGNUP_BYPASS=true

# Gemini for every bot. No per-user model key. Model id is unprefixed.
GEMINI_API_KEY=
PI_DEFAULT_PROVIDER=google
PI_DEFAULT_MODEL=gemini-3.8-flash

# No computers, no paid catalogs, no Rakazo Stripe billing.
SANDBOX_PROVIDER=none
CLOUD_AGENT_PROVIDER=none
# Leave COMPOSIO_API_KEY, PIPEDREAM_*, and STRIPE_* unset.

# Resend, same sending key LocalPitch uses. Leave the value blank here.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=LocalPitch <assistant@mail.example.com>

# Built-in web search has no off switch in the environment. Turn it off per bot
# (docs/localpitch/DEPLOY.md). It is keyless DuckDuckGo HTML when left on.
MAX_TOOL_CALLS_PER_TURN=25
MAX_UPLOAD_SIZE_MB=10

# On outside development when unset. Set it so a dev-flagged host cannot drift.
CONTENT_ENCRYPTION=on
ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
SCREEN_PROXY_SECRET=

# Messaging stays off. Do not set TELEGRAM_*, WHATSAPP_*, SENDBLUE_*, SLACK_*, or LARK_*.
MESSAGING_OPEN_SIGNUP=false
PHONE_CALLS_ENABLED=false
